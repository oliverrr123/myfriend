# Server Configuration
PORT=8080
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# API Authentication
API_KEY=your-secret-api-key

PHONE_NUMBER_TO_ID_MAP='{"+123456789": "phnum_xxx", "+4567890123": "phnum_yyy", "+12346036167": "phnum_free_us", "+19496767670": "phnum_paid_us"}'

# E.164 prefixes that must verify + subscribe on paid lines.
# +12346036167 stays a free companion line for everyone.
# +19496767670 is the paid US MyFriend number.
PAID_ACCESS_PREFIXES=+1

# Enable only after the scheduler and the consent tool have been installed.
DAILY_CHECKINS_ENABLED=false
DAILY_CHECKIN_AGENT_PHONE=+19496767670
# Twilio Messaging Service with Advanced Opt-Out and a registered SMS sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REPORT_MESSAGING_SERVICE_SID=
FAMILY_MESSAGING_ENABLED=false
FAMILY_MESSAGING_PROVIDER=twilio
# Optional: restrict a single local test worker to this E.164 number.
FAMILY_MESSAGING_TEST_PHONE=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
FAMILY_ASSISTANT_MODEL=gpt-4.1-mini
MYFRIEND_WEB_URL=https://trymyfriend.com
# MyFriend uses the existing calling number for SMS too.
TWILIO_FAMILY_NUMBER=+19496767670
FAMILY_TWILIO_WEBHOOK_URL=https://your-api.example/api/family/twilio

# Email login and family reports (verified Resend sender)
RESEND_API_KEY=
MYFRIEND_EMAIL_FROM=MyFriend <hello@trymyfriend.com>
CHECKIN_REPORTS_ENABLED=false
